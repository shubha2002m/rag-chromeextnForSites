{
  "manifest_version": 3,
  "name": "Docs Chat",
  "version": "1.0",
  "description": "Chat with any documentation site using AI",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://localhost:8000/*", "<all_urls>"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_popup": ""
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}